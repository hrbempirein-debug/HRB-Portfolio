# Server-side configuration for the HRB portfolio AI assistant.
# This file is loaded ONLY by the persistent Node server (`npm run serve`)
# and the Vite dev server. Never create a VITE_* variable for these values —
# anything prefixed VITE_ is shipped to the browser.

# Provider selection: "gemini" (native Google Gemini) or "openai-compatible".
PORTFOLIO_AI_PROVIDER=gemini

# Your provider API key. Required for live answers; when absent the
# assistant replies with a graceful "offline" message.
# For Gemini, use a Google AI Studio API key — https://aistudio.google.com/apikey
PORTFOLIO_AI_API_KEY=

# Gemini model used for answers. Free-tier Gemini Flash recommended.
PORTFOLIO_AI_MODEL=gemini-3.6-flash

# --- Only used when PORTFOLIO_AI_PROVIDER=openai-compatible ---
# OpenAI-compatible base URL + model (defaults point at OpenAI).
# PORTFOLIO_AI_BASE_URL=https://api.openai.com/v1
# PORTFOLIO_AI_MODEL=gpt-4o-mini

# Upstream request timeout in milliseconds.
# PORTFOLIO_AI_TIMEOUT_MS=30000

# Port + host for the persistent server (`npm run serve`).
# PORT=4173
# HOST=0.0.0.0